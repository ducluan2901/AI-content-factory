# dev | prod | test. prod refuses LLM_PROVIDER=claude_cli (PRD §8).
APP_ENV=dev
# anthropic_api | claude_cli (dev-only, spends the Max quota) | fixture
LLM_PROVIDER=anthropic_api
# required for anthropic_api; set a spend cap on this key in the Console
ANTHROPIC_API_KEY=
SCRIPT_MODEL=claude-sonnet-5-5
# thinking depth for the script call: low | medium | high (higher = better reasoning, more output tokens)
SCRIPT_EFFORT=medium
# claude_cli only: leave empty for the CLI default model
CLAUDE_MODEL=
# edge_tts | fixture
TTS_PROVIDER=edge_tts
TTS_VOICE_VI=vi-VN-HoaiMyNeural
TTS_VOICE_EN=en-US-AriaNeural
# pexels | local | none | fixture. pexels with no key quietly degrades to none (every scene becomes a title card);
# local picks your own images from LOCAL_STOCK_DIR by file name, no key or account needed
STOCK_PROVIDER=pexels
# free at pexels.com/api - create your own account, this app never creates one for you
PEXELS_API_KEY=
LOCAL_STOCK_DIR=./assets/stock
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# any TTF with full Vietnamese coverage
FONT_PATH=C:\Windows\Fonts\segoeuib.ttf
DATABASE_URL=sqlite:///./storage/factory.db
STORAGE_DIR=./storage
