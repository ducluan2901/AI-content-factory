{
  "name": "NDL - Dang YouTube Short",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ndl-post-youtube",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $json.body.title }}",
        "regionCode": "VN",
        "categoryId": "15",
        "binaryProperty": "video",
        "options": {
          "description": "={{ $json.body.description }}",
          "privacyStatus": "={{ $json.body.publish_at ? 'private' : 'public' }}",
          "publishAt": "={{ $json.body.publish_at || '' }}",
          "selfDeclaredMadeForKids": false,
          "notifySubscribers": true
        }
      },
      "name": "YouTube upload",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [240, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"video_id\": $json.id, \"url\": \"https://youtube.com/shorts/\" + $json.id } }}"
      },
      "name": "Tra ket qua",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "YouTube upload", "type": "main", "index": 0 }]] },
    "YouTube upload": { "main": [[{ "node": "Tra ket qua", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
